const ROOT_ID = "1hUF0G01PZkzRcONhLFRAywGi_qD8AUds";
function normalize_(v){return String(v||"").toLowerCase().replace(/[^a-z0-9]+/g," ").trim();}
function inferSubtest_(path){const p=normalize_(path);if(/(^| )pu( |$)|penalaran umum/.test(p))return"pu";if(/(^| )ppu( |$)|pengetahuan .*pemahaman umum/.test(p))return"ppu";if(/(^| )pbm( |$)|pemahaman bacaan|menulis/.test(p))return"pbm";if(/(^| )pk( |$)|pengetahuan kuantitatif/.test(p))return"pk";if(/literasi bahasa indonesia|(^| )lit indo( |$)|(^| )lit_indo( |$)/.test(p))return"lit_indo";if(/literasi bahasa inggris|(^| )lit inggris( |$)|(^| )lit_inggris( |$)/.test(p))return"lit_inggris";if(/(^| )pm( |$)|penalaran matematika/.test(p))return"pm";return"";}
function inferLevel_(path){const p=normalize_(path);if(p.indexOf("supervisor")>=0)return"supervisor";if(p.indexOf("mandor")>=0)return"mandor";return"nguli";}
function inferKind_(name,mime,path){return normalize_(path+" "+name).indexOf("video")>=0||String(mime||"").indexOf("video/")===0?"video":"module";}
function walk_(folder,path,out,seen){const id=folder.getId();if(seen[id])return;seen[id]=true;const fs=folder.getFolders();while(fs.hasNext()){const child=fs.next();walk_(child,path+"/"+child.getName(),out,seen);}const files=folder.getFiles();while(files.hasNext()){const file=files.next(),filePath=path+"/"+file.getName(),subtest=inferSubtest_(filePath);if(!subtest)continue;out.push({id:"drive-"+file.getId(),kind:inferKind_(file.getName(),file.getMimeType(),filePath),title:file.getName(),description:"Materi Wacawaci dari Google Drive",url:"https://drive.google.com/file/d/"+file.getId()+"/view",is_public:true,created_by:"Google Drive",level:inferLevel_(filePath),subtest,created_at:file.getDateCreated().toISOString()});}}
function doGet(){try{const root=DriveApp.getFolderById(ROOT_ID),out=[];walk_(root,root.getName(),out,{});return ContentService.createTextOutput(JSON.stringify({ok:true,items:out})).setMimeType(ContentService.MimeType.JSON);}catch(err){return ContentService.createTextOutput(JSON.stringify({ok:false,items:[],error:String(err&&err.message||err)})).setMimeType(ContentService.MimeType.JSON);}}